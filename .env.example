# --- Core -------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Public URL of the admin app (used in unsubscribe + preview links)
APP_URL=http://localhost:3000
# Postgres connection string. Use "pglite://.data/outreach" for a local
# embedded database with zero setup, or a Neon/Postgres URL in production.
DATABASE_URL=pglite://.data/outreach

# --- Auth (required in production, defaulted in dev) -------------------
# Password for the single admin login
ADMIN_PASSWORD=change-me-please
# Secret used to sign the session cookie (min 16 chars)
SESSION_SECRET=change-me-please-16chars

# --- Provider mode ------------------------------------------------------
# "fake" runs every external provider as an offline fake (dev/test).
# "live" requires all provider keys below.
PROVIDER_MODE=fake

# --- Google Places ------------------------------------------------------
GOOGLE_PLACES_API_KEY=
# Optional. Google Maps Embed API key for client-site map iframes. Without it
# sites use the keyless maps.google.com embed. Create at
# https://console.cloud.google.com/apis/credentials (enable "Maps Embed API"
# and restrict the key by HTTP referrer to *.<CLIENT_SITES_DOMAIN>).
GOOGLE_MAPS_EMBED_KEY=

# --- Resend (email) -----------------------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Dedicated sending subdomain, e.g. mail.yourdomain.com
SENDING_DOMAIN=mail.example.com
SENDER_NAME=Outreach
# Your first name — signs every outbound email ("Best, <name>")
SENDER_FIRST_NAME=Sam
# One honest sentence introducing yourself in the first email
SENDER_INTRO=I build simple websites for local businesses.
SENDER_LOCAL_PART=hello
# Physical postal address required in every cold email footer (CAN-SPAM)
PHYSICAL_ADDRESS=123 Example Street, Anytown, ST 00000

# --- Anthropic (reply agent + copywriting) ------------------------------
ANTHROPIC_API_KEY=

# --- Stripe --------------------------------------------------------------
# Dashboard -> Developers -> API keys -> "Secret key" (sk_live_... / sk_test_...)
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks -> "Add endpoint" with URL
#   https://<APP_URL>/api/webhooks/stripe
# and events: checkout.session.completed, invoice.paid, invoice.payment_failed,
# customer.subscription.deleted, charge.dispute.created. Copy the
# "Signing secret" (whsec_...). For local dev: `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` prints one.
STRIPE_WEBHOOK_SECRET=
# Dashboard -> Product catalog -> create a product with TWO prices: a $25/month
# recurring price and a $100 one-time price. Then Dashboard -> Payment Links ->
# "+ New" -> pick the $25/mo price, "Add another item" -> the $100 setup price
# -> Create. Paste the https://buy.stripe.com/... URL here. The app appends
# ?client_reference_id=<leadId>&prefilled_email=... (the webhook relies on
# client_reference_id to match the lead).
STRIPE_PAYMENT_LINK_URL=
# Dashboard -> Settings -> Billing -> Customer portal -> Activate link. Lets
# past-due customers update their card. Paste the https://billing.stripe.com/p/login/...
# URL here; dunning emails append ?prefilled_email=<customer email>.
STRIPE_CUSTOMER_PORTAL_URL=

# --- Hunter.io (email enrichment) ----------------------------------------
HUNTER_API_KEY=

# --- Cloudflare (client site deploys) -------------------------------------
# API token: https://dash.cloudflare.com/profile/api-tokens -> Create Token.
# Needs permissions: Account > Cloudflare Pages: Edit, Zone > DNS: Edit
# (scoped to the zone that owns CLIENT_SITES_DOMAIN).
CLOUDFLARE_API_TOKEN=
# Account ID: Cloudflare dashboard -> Workers & Pages -> right sidebar "Account ID".
CLOUDFLARE_ACCOUNT_ID=
# Zone ID of the domain that CLIENT_SITES_DOMAIN lives under:
# dashboard -> select the domain -> Overview -> right sidebar "Zone ID".
CLOUDFLARE_ZONE_ID=
# Root domain that client sites deploy under, e.g. sites.yourdomain.com.
# Each live site becomes https://<slug>.<CLIENT_SITES_DOMAIN> (proxied CNAME,
# created automatically). The domain must be on the Cloudflare zone above.
CLIENT_SITES_DOMAIN=sites.example.com
# Prefix for per-site Cloudflare Pages projects (project = <prefix>-<slug>).
CLIENT_SITES_PROJECT_PREFIX=site

# --- Alerts ----------------------------------------------------------------
# Where red-state health alerts are sent
ALERT_EMAIL=
