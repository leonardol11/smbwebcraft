# --- Core -------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Public URL of the admin app (used in unsubscribe + preview links)
APP_URL=http://localhost:3000
# Postgres connection string. Use "pglite://.data/outreach" for a local
# embedded database with zero setup, or a Neon/Postgres URL in production.
DATABASE_URL=pglite://.data/outreach

# --- Auth (required in production, defaulted in dev) -------------------
# Password for the single admin login
ADMIN_PASSWORD=change-me-please
# Secret used to sign the session cookie (min 16 chars)
SESSION_SECRET=change-me-please-16chars

# --- Provider mode ------------------------------------------------------
# "fake" runs every external provider as an offline fake (dev/test).
# "live" requires all provider keys below.
PROVIDER_MODE=fake

# --- Google Places ------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# --- Resend (email) -----------------------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Dedicated sending subdomain, e.g. mail.yourdomain.com
SENDING_DOMAIN=mail.example.com
SENDER_NAME=Outreach
SENDER_LOCAL_PART=hello
# Physical postal address required in every cold email footer (CAN-SPAM)
PHYSICAL_ADDRESS=123 Example Street, Anytown, ST 00000

# --- Anthropic (reply agent + copywriting) ------------------------------
ANTHROPIC_API_KEY=

# --- Stripe --------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The single Payment Link in subscription mode ($100 one-time + $25/mo)
STRIPE_PAYMENT_LINK_URL=

# --- Hunter.io (email enrichment) ----------------------------------------
HUNTER_API_KEY=

# --- Cloudflare (client site deploys) -------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# Root domain that client sites deploy under, e.g. sites.yourdomain.com
CLIENT_SITES_DOMAIN=sites.example.com

# --- Alerts ----------------------------------------------------------------
# Where red-state health alerts are sent
ALERT_EMAIL=
